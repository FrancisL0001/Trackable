# Trackable backend configuration. Copy to .env and edit as needed.
# All values have demo-safe defaults; the app runs with no .env at all.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Security (CHANGE THESE IN PRODUCTION) ---
SECRET_KEY=dev-insecure-secret-change-me
# Optional Fernet key (urlsafe base64, 32 bytes). If unset it is derived from SECRET_KEY.
# ENCRYPTION_KEY=

# --- Database ---
DATABASE_URL=sqlite:///./trackable.db

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173
# EXTRA_CORS_ORIGINS=https://app.example.com,https://www.example.com

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_SYNC=10/minute

# --- Caching ---
CACHE_TTL_SECONDS=60

# --- Integrations ---
# Demo mode returns realistic sample data without real credentials.
# Set to false to use real provider clients (requires per-connection secrets).
DEMO_MODE=true
CANVAS_BASE_URL=https://canvas.instructure.com
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
