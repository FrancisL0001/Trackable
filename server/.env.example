# Trackable backend configuration. Copy to .env and edit as needed.
# All values have demo-safe defaults; the app runs with no .env at all locally.
#
# IMPORTANT: In any non-development environment (e.g. ENVIRONMENT=production, or when
# deployed on Railway) the app FAILS TO START unless SECRET_KEY, ENCRYPTION_KEY,
# DEBUG=false, and a non-localhost FRONTEND_ORIGIN are properly set. This is intentional
# (fail closed). See docs/DEPLOYMENT.md.

# --- App ---
# Use "production" when deploying. Railway is treated as production automatically.
ENVIRONMENT=development
DEBUG=true

# --- Security (REQUIRED IN PRODUCTION) ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me
# Separate key for encrypting integration secrets at rest. REQUIRED in production.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

# --- Database ---
# Local default is SQLite. In production prefer managed Postgres (Railway provides
# DATABASE_URL automatically when you add a Postgres service).
DATABASE_URL=sqlite:///./trackable.db

# --- CORS ---
# Set to your deployed frontend origin in production (e.g. your Vercel URL).
# Must NOT be localhost or "*" in production.
FRONTEND_ORIGIN=http://localhost:5173
# EXTRA_CORS_ORIGINS=https://app.example.com,https://www.example.com

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_SYNC=10/minute

# --- Caching ---
CACHE_TTL_SECONDS=60

# --- Background sync ---
# Freshness SLA: active connections re-sync every N minutes while the server runs.
SYNC_INTERVAL_MINUTES=30
SYNC_SCHEDULER_ENABLED=true

# --- Integrations ---
# Demo mode returns realistic sample data without real credentials.
# Set to false to use real provider clients (requires per-connection secrets).
DEMO_MODE=true
CANVAS_BASE_URL=https://canvas.instructure.com

# --- Course-website AI import (optional) ---
# The "Course website" provider extracts deadlines from assignment pages that
# have no calendar feed. It needs ONE of the following; otherwise it is
# demo-only and hidden in live mode.
#
# Option A - your own local model via Ollama (free, no API key):
#   ollama pull qwen2.5:3b && ollama serve
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=qwen2.5:3b
# qwen2.5:3b is the tested minimum; 7b+ extracts more reliably. Any
# OpenAI-compatible endpoint works here (LM Studio, vLLM, hosted providers);
# set LLM_API_KEY if the endpoint requires one.
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=
#
# Option B - Anthropic API (used only when LLM_BASE_URL is unset):
# ANTHROPIC_API_KEY=
#
# Page-text budget per extraction. The 6000 default fits Ollama's small default
# context window; raise it (e.g. 20000) for hosted or large-context models.
# LLM_MAX_PAGE_CHARS=6000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
